{
  "info": {
    "name": "API das Ninas",
    "description": "Rotas de cadastro, login e recuperação de senha da API das Ninas. Rode a API localmente (veja o README) e execute as requisições na ordem: o login salva o token na variável {{token}}, usada pela rota protegida.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "email", "value": "maria@email.com" },
    { "key": "password", "value": "senha123" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Cadastro",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Maria\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('devolve um token', () => pm.expect(body.token).to.be.a('string'));",
              "pm.collectionVariables.set('token', body.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/authenticate",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      }
    },
    {
      "name": "Rota protegida",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('ok = true', () => pm.expect(pm.response.json().ok).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": "{{baseUrl}}/projects"
      }
    },
    {
      "name": "Esqueci a senha",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/forgot_password",
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\"\n}" }
      }
    },
    {
      "name": "Redefinir senha",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/reset_password",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"token\": \"token-recebido-por-email\",\n  \"password\": \"nova-senha\"\n}"
        }
      }
    }
  ]
}
